# Assistant du portfolio (facultatif).
# Sans clé, l'assistant répond avec les informations du site (mode local, gratuit).
# Copie ce fichier en .env.local pour tester, et déclare les mêmes variables chez ton hébergeur.

# Option 1 : API Anthropic (Claude)
ANTHROPIC_API_KEY=
# CHAT_MODEL=claude-haiku-4-5

# Option 2 : toute API compatible OpenAI (Groq, OpenRouter, Gemini...)
# CHAT_API_KEY=
# CHAT_API_URL=https://api.groq.com/openai/v1
# CHAT_MODEL=llama-3.3-70b-versatile
